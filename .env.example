APP_NAME="متجر زاد نيكس | ZADNEX STORE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.zadnexstore.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (For Hostinger MySQL)
# To use MySQL on Hostinger:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u_database_name
DB_USERNAME=u_database_user
DB_PASSWORD=your_database_password

# Or to use SQLite on Hostinger:
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@zadnexstore.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@zadnexstore.com"
MAIL_FROM_NAME="متجر زاد نيكس"

VITE_APP_NAME="${APP_NAME}"
